{
  email {$ACME_EMAIL}
}

{$DOMAIN} {
  root * /srv
  encode zstd gzip

  file_server

  handle_errors {
    root * /srv
    rewrite * /404.html
    file_server
  }
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    X-Frame-Options SAMEORIGIN
  }
}
