---
import './styles.css';
import { getProfile, mediaUrl } from './lib/content.js';

const profile = getProfile();
const resumeUrl = mediaUrl(profile.resume);
const theme = profile.theme || {};
const safeHex = (value) => (/^#([0-9a-f]{3}|[0-9a-f]{6})$/i.test(value || '') ? value : null);
const themeStyle = [
  ['--cream', safeHex(theme.cream)],
  ['--ink', safeHex(theme.ink)],
  ['--orange', safeHex(theme.orange)],
]
  .filter(([, value]) => value)
  .map(([name, value]) => `${name}:${value};`)
  .join(' ');
const themeColor = safeHex(theme.cream) || '#f3eee3';
const {
  title,
  description,
  ogImage,
  ogImageAlt,
  type = 'website',
  noindex = false,
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;
const pageTitle = title || profile.seo.title;
const pageDescription = description || profile.seo.description;
const siteUrl = (Astro.site?.href || profile.site_url || '').replace(/\/+$/, '');
const canonicalPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonicalUrl = new URL(canonicalPath, siteUrl).href;
const shareImage = ogImage || profile.seo.og_image || '/og.png';
const shareImageUrl = shareImage ? new URL(mediaUrl(shareImage), siteUrl).href : null;
const shareImageAlt = (ogImage && ogImageAlt) || `${profile.name} — ${profile.role}`;
const structuredData = jsonLd
  ? {
      '@context': 'https://schema.org',
      '@graph': Array.isArray(jsonLd) ? jsonLd : [jsonLd],
    }
  : null;
const jsonLdHtml = structuredData
  ? JSON.stringify(structuredData).replace(/</g, '\\u003c')
  : null;

const nav = [
  { label: 'Experience', href: '/#experience' },
  { label: 'Work', href: '/#work' },
  { label: 'Credentials', href: '/#credentials' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/#about' },
  { label: 'Contact', href: '/#contact' },
];
---

<!doctype html>
<html lang="en" id="top" style={themeStyle}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta
      name="robots"
      content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'}
    />
    <meta name="author" content={profile.name} />
    {profile.google_site_verification && (
      <meta name="google-site-verification" content={profile.google_site_verification} />
    )}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} — Writing`}
      href="/rss.xml"
    />
    <meta name="theme-color" content={themeColor} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    {shareImageUrl && <meta property="og:image" content={shareImageUrl} />}
    {shareImageUrl && <meta property="og:image:alt" content={shareImageAlt} />}
    {shareImage === '/og.png' && <meta property="og:image:width" content="1200" />}
    {shareImage === '/og.png' && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {shareImageUrl && <meta name="twitter:image" content={shareImageUrl} />}
    {shareImageUrl && <meta name="twitter:image:alt" content={shareImageAlt} />}
    {jsonLdHtml && <script type="application/ld+json" set:html={jsonLdHtml}></script>}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico?v=6" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png?v=6" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png?v=6" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=6" />
  </head>
  <body>
    <header class="nav">
      <div class="wrap nav-inner">
        <a class="brand" href="/">{profile.name}<span class="brand-dot">.</span></a>
        <nav class="nav-links" id="nav-menu" aria-label="Primary">
          {nav.map((item) => <a class="mono nav-text" href={item.href}>{item.label}</a>)}
          {resumeUrl && <a class="btn btn-primary btn-sm" href={resumeUrl} download>Résumé</a>}
        </nav>
        <button
          class="nav-toggle"
          type="button"
          aria-label="Open menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer-inner">
        <p class="mono">© {new Date().getFullYear()} {profile.name}</p>
        <p class="mono badge">{profile.footer_badge}</p>
        <a class="mono link-inline" href="#top">Back to top ↑</a>
      </div>
    </footer>

    <script>
      const header = document.querySelector('.nav');
      const toggle = document.querySelector('.nav-toggle');
      if (header && toggle) {
        const setOpen = (open) => {
          header.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        };
        toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
        header.querySelectorAll('.nav-links a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setOpen(false);
        });
        document.addEventListener('click', (event) => {
          if (header.classList.contains('is-open') && !header.contains(event.target)) setOpen(false);
        });
        window.addEventListener('resize', () => {
          if (window.innerWidth > 820) setOpen(false);
        });
      }
    </script>
  </body>
</html>
