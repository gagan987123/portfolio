---
import Layout from '../../Layout.astro';
import { getProfile, getPosts, formatDate } from '../../lib/content.js';

const profile = getProfile();
const posts = getPosts();
const [featured, ...rest] = posts;
---

<Layout title={`Writing — ${profile.name}`} description="Notes on backends, infrastructure, and running things in the cloud.">
  <header class="page-head wrap">
    <p class="mono sec-label">Writing</p>
    <h1>Notes on building<br /><em style="color:var(--orange);font-style:italic">and running</em> things.</h1>
    <p class="page-lede">Short, practical posts about backend systems, cloud costs, and the unglamorous parts of operations.</p>
  </header>

  <section class="wrap" style="padding-bottom: 100px">
    {featured && (
      <a class="featured" href={`/blog/${featured.slug}`}>
        <div class="post-meta mono">
          <span>Latest</span>
          <span>{formatDate(featured.data.date)}</span>
        </div>
        <h2>{featured.data.title}</h2>
        <p>{featured.data.excerpt}</p>
        <span class="mono" style="color:var(--orange)">Read the post →</span>
      </a>
    )}

    {rest.length > 0 && (
      <div class="post-grid">
        {rest.map((post) => (
          <a class="post-card" href={`/blog/${post.slug}`}>
            <div class="post-meta mono">
              <span>{formatDate(post.data.date)}</span>
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.excerpt}</p>
          </a>
        ))}
      </div>
    )}

    {posts.length === 0 && <p class="page-lede">No posts yet — check back soon.</p>}
  </section>
</Layout>
