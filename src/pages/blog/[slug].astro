---
import Layout from '../../Layout.astro';
import {
  getPosts,
  getProfile,
  formatDate,
  renderMarkdown,
  mediaUrl,
  categorySlug,
} from '../../lib/content.js';

export function getStaticPaths() {
  return getPosts().map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const profile = getProfile();
const html = renderMarkdown(post.body);
const cover = mediaUrl(post.data.cover);
const siteUrl = (profile.site_url || '').replace(/\/+$/, '');
const toIso = (value) => {
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? undefined : date.toISOString();
};
const publishedIso = toIso(post.data.date);
const modifiedIso = toIso(post.data.updated || post.data.date);
const postUrl = `${siteUrl}/blog/${post.slug}`;
const category = (post.data.category || 'Uncategorized').trim() || 'Uncategorized';
const categoryUrl = `${siteUrl}/blog/category/${categorySlug(category)}`;
const coverUrl = cover ? new URL(cover, siteUrl).href : undefined;
const author = {
  '@type': 'Person',
  '@id': `${siteUrl}/#person`,
  name: profile.name,
  url: `${siteUrl}/`,
};
const blogPosting = {
  '@type': 'BlogPosting',
  '@id': `${postUrl}#article`,
  headline: post.data.title,
  description: post.data.excerpt,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  author,
  publisher: author,
  mainEntityOfPage: { '@type': 'WebPage', '@id': postUrl },
  url: postUrl,
  ...(coverUrl && { image: coverUrl }),
  ...(post.data.tags?.length && { keywords: post.data.tags.join(', ') }),
  articleSection: category,
  inLanguage: 'en',
};
const breadcrumbs = {
  '@type': 'BreadcrumbList',
  '@id': `${postUrl}#breadcrumb`,
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: `${siteUrl}/` },
    { '@type': 'ListItem', position: 2, name: 'Writing', item: `${siteUrl}/blog` },
    { '@type': 'ListItem', position: 3, name: category, item: categoryUrl },
    { '@type': 'ListItem', position: 4, name: post.data.title, item: postUrl },
  ],
};
---

<Layout
  title={`${post.data.title} — ${profile.name}`}
  description={post.data.excerpt}
  type="article"
  ogImage={post.data.cover}
  ogImageAlt={post.data.title}
  publishedTime={publishedIso}
  modifiedTime={modifiedIso}
  jsonLd={[blogPosting, breadcrumbs]}
>
  <article class="article">
    <header class="article-head">
      <p class="mono sec-label">
        Writing / <a class="category-link" href={categoryUrl}>{category}</a>
      </p>
      <h1>{post.data.title}</h1>
      <div class="post-meta mono">
        <span>{profile.name}</span>
        <time datetime={publishedIso}>{formatDate(post.data.date)}</time>
      </div>
    </header>

    {cover && <img src={cover} alt={post.data.title} decoding="async" style="margin-bottom:2rem;border:1px solid var(--line)" />}

    <div class="prose" set:html={html} />

    <a class="mono link-inline back-link" href="/blog">← All posts</a>
  </article>
</Layout>
