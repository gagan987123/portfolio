---
import Layout from '../Layout.astro';
---

<Layout
  title="Page not found"
  description="That page doesn't exist — maybe it moved, or maybe it never did."
  noindex
>
  <section class="article" style="text-align:center">
    <p class="mono sec-label">404</p>
    <h1>Page not found</h1>
    <p class="page-lede" style="margin:0 auto 28px">That page doesn't exist — maybe it moved, or maybe it never did.</p>
    <a class="btn btn-primary" href="/">Back home <span aria-hidden="true">→</span></a>
  </section>
</Layout>
